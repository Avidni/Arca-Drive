# ── App ──────────────────────────────────────────────
# Public — safe for browser.
NEXT_PUBLIC_APP_NAME=Arca Drive
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public base URL for media files served from R2 (read-only).
# This is NOT a secret — it is used in public URLs.
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com

# ── Supabase ─────────────────────────────────────────
# Public — safe for browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY — never expose to the browser.
# Used for admin-level operations (e.g. creating users).
# If leaked, an attacker could bypass Row-Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 ────────────────────────────────────
# SERVER-ONLY — never expose to the browser.
# These credentials grant write access to your R2 bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# R2 endpoint (e.g. https://<accountid>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# Public URL prefix for R2 objects (read-only).
# Not a secret — used to construct public file URLs.
R2_PUBLIC_BASE_URL=

# ── Upload Limits ────────────────────────────────────
# Configured per user in Settings → Upload limits (stored in the database and
# enforced server-side). No environment variables needed.

# ── Optional ─────────────────────────────────────────
NODE_ENV=development
